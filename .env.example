# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
# Google Drive (Shared Drives primary)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_REDIRECT_URI=https://drive.eiden-group.com/api/auth/google/callback
NEXT_PUBLIC_APP_URL=https://drive.eiden-group.com
GOOGLE_WEBHOOK_URL=https://drive.eiden-group.com/api/drive/webhook
# Shared secret Google echoes back in X-Goog-Channel-Token (random hex). Webhook rejects everything if unset.
GOOGLE_WEBHOOK_TOKEN=
# One-time setup gate for /api/auth/google (optional, remove after token obtained)
APP_SETUP_KEY=
# Local agent (outbound only, mTLS)
AGENT_TOKEN=
AGENT_WS_URL=wss://drive.eiden-group.com/api/agent
# Vault (master key lives in Supabase Vault, never here)
VAULT_KEK_ID=

# Vault encryption key — 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Server-only. Losing it makes existing vault items unreadable; rotating it needs re-sealing.
VAULT_KEK=

# Slack upload notifications — Incoming Webhook URL for the channel (Slack → Apps → Incoming Webhooks).
# Unset = Slack posts are skipped silently; Storage page shows "not connected".
SLACK_WEBHOOK_URL=
