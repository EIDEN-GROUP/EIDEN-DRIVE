# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
# Google Drive (Shared Drives primary)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_REDIRECT_URI=https://drive.eiden-group.com/api/auth/google/callback
NEXT_PUBLIC_APP_URL=https://drive.eiden-group.com
GOOGLE_WEBHOOK_URL=https://drive.eiden-group.com/api/drive/webhook
# Shared secret Google echoes back in X-Goog-Channel-Token (random hex). Webhook rejects everything if unset.
GOOGLE_WEBHOOK_TOKEN=
# One-time setup gate for /api/auth/google (optional, remove after token obtained)
APP_SETUP_KEY=
# Local agent (outbound only, mTLS)
AGENT_TOKEN=
AGENT_WS_URL=wss://drive.eiden-group.com/api/agent
# Vault (master key lives in Supabase Vault, never here)
VAULT_KEK_ID=

# Vault encryption key — 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Server-only. Losing it makes existing vault items unreadable; rotating it needs re-sealing.
VAULT_KEK=

# Outgoing mail (EVERY Eiden email goes through here — Supabase never sends mail).
# Port 465 = implicit SSL. Port 587 = STARTTLS (TLS is always required).
# Gmail/Outlook need an App Password, not the login password.
# DNS for deliverability: SPF + DKIM + DMARC on your sending domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Eiden Drive <drive@eiden-group.com>"

# Slack upload notifications — Incoming Webhook URL for the channel (Slack → Apps → Incoming Webhooks).
# Unset = Slack posts are skipped silently; Storage page shows "not connected".
SLACK_WEBHOOK_URL=

# Slack bot (slash command, modals, link unfurls, account linking) — server-only, never NEXT_PUBLIC_*.
# Unset = bot features refuse loudly; upload notifications (webhook above) keep working.
# After ANY scope or unfurl-domain change: reinstall/reauthorize the app or Slack serves the old grants.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Reserved for OAuth install flows (not required for single-workspace installs).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://drive.eiden-group.com/api/slack/oauth/callback
# Cron worker guard for POST /api/slack/process (Vercel → Settings → Environment Variables → CRON_SECRET;
# Vercel Cron sends it as the Authorization bearer automatically).
CRON_SECRET=
